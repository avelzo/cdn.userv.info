# URL et secret Better Auth (générer un secret distinct en production)
BETTER_AUTH_URL=https://cdn.userv.info
BETTER_AUTH_SECRET=
# À renseigner seulement pour la commande de migration, après l'inventaire.
BETTER_AUTH_EXPECTED_USER_COUNT=

# Protection du login. En production, garder AUTH_CAPTCHA_REQUIRED=true.
AUTH_CAPTCHA_REQUIRED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=cdn.userv.info

# À renseigner seulement pour la commande de publication, après l'inventaire.
MEDIA_EXPECTED_PRIVATE_COUNT=

# SMTP
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_WIDTH=12000
UPLOAD_MAX_HEIGHT=12000
UPLOAD_MAX_PIXELS=40000000
UPLOAD_TOTAL_QUOTA_BYTES=1073741824
UPLOAD_DAILY_QUOTA_BYTES=104857600
UPLOAD_RATE_LIMIT=30
UPLOAD_MAX_CONCURRENT=2
